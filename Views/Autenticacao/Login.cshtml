@model ScarFood.Models.Usuario

@{
    ViewData["Title"] = "Login";
}

<div class="row justify-content-center">
    <div class="col-md-4 mt-5">
        <div class="card shadow border-0" style="border-radius: 15px;">
            <div class="card-body p-4">
                <h2 class="card-title text-center fw-bold text-danger">Entrar</h2>
                <hr />

                @* IMPLEMENTAÇÃO: Exibição da mensagem de erro vinda do Controller *@
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3 text-center"></div>

                <form asp-action="Login" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-bold small">E-mail</label>
                        <input asp-for="Email" class="form-control" placeholder="admin@scarfood.com" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small">Senha</label>
                        <input asp-for="Senha" type="password" class="form-control" placeholder="******" required />
                        <span asp-validation-for="Senha" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-danger w-100 fw-bold py-2" style="background-color: #EA1D2C;">Entrar</button>
                </form>
                
                <p class="mt-3 text-center small">
                    Não tem uma conta? <a href="/Autenticacao/Registro" class="text-danger fw-bold text-decoration-none">Registre-se aqui</a>
                </p>
            </div>
        </div>
    </div>
</div>

@* Adicionado para evitar erros de carregamento de validação *@
@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.13/jquery.validate.unobtrusive.min.js"></script>
}