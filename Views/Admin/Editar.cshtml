@model ScarFood.Models.Produto

@{
    ViewData["Title"] = "Editar Produto";
}

<div class="container mt-5 mb-5">
    <div class="card border-0 shadow-lg" style="border-radius: 15px; max-width: 900px; margin: 0 auto;">
        <div class="card-header border-0 text-white p-4"
             style="background-color: #EA1D2C; border-radius: 15px 15px 0 0;">
            <h4 class="fw-bold mb-0"><i class="fas fa-edit me-2"></i>Editar: @Model.Nome</h4>
        </div>
        
        <div class="card-body p-4 p-md-5">
            <form asp-action="Editar" asp-controller="Admin" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="FotoUrl" />
                <div class="row g-4">
                    <div class="col-md-6">
                        <h6 class="fw-bold text-danger mb-3">Informações Principais</h6>
                        
                        <div class="mb-3">
                            <label class="form-label fw-bold small text-muted">Nome do Produto</label>
                            <input asp-for="Nome" class="form-control bg-light border-0" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small text-muted">Descrição</label>
                            <textarea asp-for="Descricao" class="form-control bg-light border-0" rows="3"></textarea>
                        </div>

                        <div class="row">
                            <div class="col-6 mb-3">
                                <label class="form-label fw-bold small text-muted">Preço (R$)</label>
                                <input asp-for="Preco" type="text" class="form-control bg-light border-0"
                                       value="@Model.Preco.ToString("G", System.Globalization.CultureInfo.InvariantCulture)"
                                       required />
                            </div>>
                            <div class="col-6 mb-3">
                                <label class="form-label fw-bold small text-muted">Categoria</label>
                                <select asp-for="Categoria" class="form-select bg-light border-0">
                                    <option value="Lanche">Lanche</option>
                                    <option value="Pizza">Pizza</option>
                                    <option value="Bebida">Bebida</option>
                                    <option value="Sobremesa">Sobremesa</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small text-muted">Atualizar Foto (Deixe em branco para
                                manter)</label>
                                <input type="file" name="FotoNova" class="form-control bg-light border-0" accept="image/*">
                                @if (!string.IsNullOrEmpty(Model.FotoUrl))
                                {
                                    <div class="mt-2 text-muted small">
                                        <i class="fas fa-image me-1"></i> Foto atual: @Model.FotoUrl.Split('/').Last()
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="col-md-6 border-start ps-md-4">
                            <h6 class="fw-bold text-danger mb-3">Personalizar Pedido (Ingredientes)</h6>
                            <p class="text-muted small">Edite ou adicione ingredientes extras para este lanche.</p>
                        
                            <div id="listaIngredientesEdit">
                                @if (Model.Extras != null && Model.Extras.Count > 0)
                                {
                                    @foreach (var extra in Model.Extras)
                                    {
                                        <div class="row g-2 mb-2 align-items-end ingrediente-row">
                                            <div class="col-7">
                                                <label class="small fw-bold text-muted">Nome</label>
                                                <input type="text" name="IngredientesNomes" value="@extra.Nome"
                                                       class="form-control bg-light border-0" required>
                                            </div>
                                            <div class="col-3">
                                                <label class="small fw-bold text-muted">Preço</label>
                                                <input type="text" name="IngredientesPrecos" value="@extra.Preco.ToString("F2")"
                                                       class="form-control bg-light border-0" required>
                                            </div>
                                            <div class="col-2">
                                                <button type="button" class="btn btn-light text-danger w-100"
                                                        onclick="this.closest('.ingrediente-row').remove()"><i
                                                    class="fas fa-trash"></i></button>
                                                </div>
                                            </div>
                                        }
                                    }
                                </div>
                        
                                <button type="button" class="btn btn-outline-danger btn-sm fw-bold w-100 rounded-pill mt-2"
                                        onclick="adicionarLinhaIngredienteEdit()">
                                    + Adicionar Ingrediente
                                </button>
                            </div>
                        </div>

                        <hr class="my-4">
                        <div class="d-flex gap-3">
                            <a href="/Admin/Painel" class="btn btn-light w-50 fw-bold border py-3 text-muted">Cancelar</a>
                            <button type="submit" class="btn btn-danger w-50 fw-bold py-3 shadow-sm"
                                    style="background-color: #EA1D2C;">Salvar Alterações</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        @section Scripts {
            <script>
                function adicionarLinhaIngredienteEdit() {
                    let container = document.getElementById("listaIngredientesEdit");
                    let div = document.createElement("div");
                    div.className = "row g-2 mb-2 align-items-end ingrediente-row";
            
                    div.innerHTML = `
                            <div class="col-7">
                                <label class="small fw-bold text-muted">Nome (Ex: Bacon)</label>
                                <input type="text" name="IngredientesNomes" class="form-control bg-light border-0" required>
                            </div>
                            <div class="col-3">
                                <label class="small fw-bold text-muted">Preço</label>
                                <input type="text" name="IngredientesPrecos" class="form-control bg-light border-0" placeholder="0,00" required>
                            </div>
                            <div class="col-2">
                                <button type="button" class="btn btn-light text-danger w-100" onclick="this.closest('.ingrediente-row').remove()"><i class="fas fa-trash"></i></button>
                            </div>
                        `;
                    container.appendChild(div);
                }
            </script>
        }