@model List<ScarFood.Models.Pedido>

@{
    ViewData["Title"] = "Meus Pedidos";
}

<div class="container mt-4">
    <h3 class="fw-bold mb-4">Histórico de Pedidos</h3>

    @if (Model == null || Model.Count == 0)
    {
        <div class="text-center py-5">
            <p class="text-muted">Nenhum pedido encontrado por enquanto.</p>
            <a href="/" class="btn btn-danger btn-sm rounded-pill fw-bold">Ir para o Cardápio</a>
        </div>
    }
    else
    {
        @foreach (var p in Model)
        {
            // MÁGICA DO NÚMERO DO PEDIDO: Como a lista está do mais novo pro mais velho,
            // nós subtraímos a posição dele do total. Assim o primeiro pedido dele sempre será #1!
            int numeroDoPedidoDoCliente = Model.Count - Model.IndexOf(p);

            string badgeColor = "bg-secondary";
            string borderColor = "#ccc";
            
            if (p.Status == "AGUARDANDO") { badgeColor = "bg-warning text-dark"; borderColor = "#fd7e14"; }
            else if (p.Status == "EM PREPARO") { badgeColor = "bg-success"; borderColor = "#28a745"; }
            else if (p.Status == "SAIU PARA ENTREGA") { badgeColor = "bg-danger"; borderColor = "#dc3545"; }
            else if (p.Status == "CONCLUIDO") { badgeColor = "bg-primary"; borderColor = "#0d6efd"; }

            <div class="card border-0 shadow-sm mb-4"
                 style="border-radius: 12px; border-left: 5px solid @borderColor !important;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                        <div>
                            <span class="badge @badgeColor mb-2">@p.Status</span>
                            <h6 class="fw-bold mb-0">Pedido #@numeroDoPedidoDoCliente - ScarFood</h6>
                            <small class="text-muted">@p.Data • R$ @p.Total</small>
                        </div>
                        
                        <div class="d-flex gap-2">
                            @if (p.Status != "CONCLUIDO")
                            {
                                <button class="btn btn-outline-danger btn-sm fw-bold px-3 rounded-pill"
                                        onclick="abrirChat('@p.Id', '@numeroDoPedidoDoCliente')">
                                    <i class="fas fa-comment-dots"></i> Chat com a Loja
                                </button>
                            }
                            else
                            {
                                <form asp-action="RepetirPedido" asp-controller="Carrinho" method="post">
                                    <input type="hidden" name="pedidoId" value="@p.Id" />
                                    <button type="submit" class="btn btn-light btn-sm fw-bold text-danger shadow-sm border">
                                        <i class="fas fa-redo"></i> Repetir Pedido
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

<div class="modal fade" id="chatModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0" style="border-radius: 15px;">
            <div class="modal-header text-white" style="background-color: #EA1D2C;">
                <h6 class="modal-title fw-bold"><i class="fas fa-store me-2"></i>Atendimento ScarFood - Pedido #<span
                    id="labelPedidoId"></span></h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body bg-light" id="chatContainer" style="height: 350px; overflow-y: auto;">
                </div>
                <div class="modal-footer p-2 bg-white border-0">
                    <div class="input-group">
                        <input type="text" id="chatInput" class="form-control border-0 bg-light"
                               placeholder="Envie sua mensagem...">
                        <button class="btn btn-danger" style="background-color: #EA1D2C;" onclick="enviarMensagemChat()"><i
                            class="fas fa-paper-plane"></i></button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @section Scripts {
            <script>
                // ==========================================
                // LÓGICA DO CHAT (VERSÃO CLIENTE) COM AUTO-UPDATE
                // ==========================================
                let chatClienteAtualId = ""; // Deixamos vazio como string por causa do NoSQL
                let chatIntervalCliente = null;

                function abrirChat(id, numeroVisual) {
                    chatClienteAtualId = id;
            
                    // Tenta atualizar o número do pedido no título do modal (se existir o span)
                    let labelId = document.getElementById('labelPedidoId');
                    // Usamos a variavel numeroVisual que vem do HTML lá em cima
                    if (labelId) labelId.innerText = numeroVisual;

                    const container = document.getElementById('chatContainer');
                    container.innerHTML = '<div class="text-center small text-muted my-3">Carregando...</div>';
            
                    new bootstrap.Modal(document.getElementById('chatModal')).show();
            
                    carregarMensagensCliente(); // Carrega a primeira vez imediatamente
            
                    // Liga o cronômetro para atualizar a cada 3 segundos
                    clearInterval(chatIntervalCliente);
                    chatIntervalCliente = setInterval(carregarMensagensCliente, 3000);
                }

                function carregarMensagensCliente() {
                    $.get("/Home/ObterChat?pedidoId=" + chatClienteAtualId, function (res) {
                        if (res.success) {
                            const container = document.getElementById('chatContainer');
                    
                            // Conta mensagens para saber se chegou algo novo
                            let qtdAtualNaTela = container.querySelectorAll('.d-flex.flex-column').length;
                            let qtdNoBanco = res.mensagens ? res.mensagens.length : 0;

                            // Só atualiza o HTML se a quantidade for diferente
                            if (qtdNoBanco !== qtdAtualNaTela) {
                                container.innerHTML = '<div class="text-center small text-muted my-3">Hoje</div>';
                                if (res.mensagens && res.mensagens.length > 0) {
                                    res.mensagens.forEach(m => renderizarMensagemCliente(m));
                                }
                                container.scrollTop = container.scrollHeight; // Desce a barra de rolagem
                            }
                        }
                    });
                }

                // Desliga o cronômetro quando o cliente fecha o chat para não travar o navegador
                document.getElementById('chatModal').addEventListener('hidden.bs.modal', function () {
                    clearInterval(chatIntervalCliente);
                });

                function renderizarMensagemCliente(m) {
                    const container = document.getElementById('chatContainer');
                    let isCliente = m.remetente === "Cliente";
            
                    let iconStatus = '<i class="fas fa-check" style="color: #bbb;"></i>';
                    if (m.statusVisto === 'Visto') iconStatus = '<i class="fas fa-check-double text-white"></i>'; // Azul/Branco quando lido

                    let html = "";
                    if (isCliente) {
                        html = `
                            <div class="d-flex flex-column align-items-end mb-3 text-end">
                                <div class="text-white p-2 rounded-3 shadow-sm small text-start" style="max-width: 80%; background-color: #EA1D2C;">
                                    ${m.texto}
                                    <div class="d-flex justify-content-end align-items-center gap-1 mt-1" style="font-size: 0.65rem;">
                                        <span style="color: #ffcccc;">${m.dataHora}</span>
                                        ${iconStatus}
                                    </div>
                                </div>
                            </div>`;
                    } else {
                        html = `
                            <div class="d-flex flex-column align-items-start mb-3">
                                <div class="bg-white p-2 rounded-3 shadow-sm small" style="max-width: 80%; border-left: 3px solid #212529;">
                                    <strong class="d-block text-dark" style="font-size: 0.7rem;">ScarFood</strong>
                                    ${m.texto}
                                    <div class="text-end text-muted mt-1" style="font-size: 0.65rem;">
                                        <span>${m.dataHora}</span>
                                    </div>
                                </div>
                            </div>`;
                    }
                    container.innerHTML += html;
                }

                function enviarMensagemChat() {
                    const input = document.getElementById('chatInput');
                    let texto = input.value.trim();
            
                    if (texto !== "") {
                        $.post("/Home/EnviarMensagemChat", { pedidoId: chatClienteAtualId, texto: texto }, function (res) {
                            if (res.success) {
                                renderizarMensagemCliente(res.mensagem);
                                input.value = "";
                                const container = document.getElementById('chatContainer');
                                container.scrollTop = container.scrollHeight;
                            }
                        });
                    }
                }

                document.getElementById('chatInput').addEventListener('keypress', function (e) {
                    if (e.key === 'Enter') enviarMensagemChat();
                });
            </script>
        }