@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="ScarFood - Peça os melhores lanches, pizzas e bebidas da cidade. Delivery rápido e fácil em Araçatuba." />
    <title>ScarFood - Delivery</title>
   
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <style>
        :root { --ifood-red: #EA1D2C; --ifood-white: #FFFFFF; }
       
        body { font-family: 'Segoe UI', sans-serif; background-color: #f7f7f7; transition: background-color 0.3s ease; }
        .text-ifood-red { color: var(--ifood-red) !important; }
        .bg-ifood-red { background-color: var(--ifood-red) !important; }
       
        /* Navbar Padrão e Ajustes Mobile */
        .navbar { border-bottom: 3px solid var(--ifood-red) !important; min-height: 80px; transition: background-color 0.3s ease; }
        .nav-link:hover { color: var(--ifood-red) !important; }
        .nav-icon { color: var(--ifood-red); font-size: 1.4rem; }

        /* Localize e substitua o trecho do mobile por este */
        @@media (max-width: 576px) {
            .nav-icon {
                font-size: 1.1rem !important;
            }
            .navbar-brand { font-size: 1.2rem !important; }
            .navbar { min-height: 60px !important; height: auto !important; }
        }

        /* Horário Fixo no Topo */
        .hours-strip { background: var(--ifood-red); color: white; font-size: 0.75rem; padding: 5px 0; font-weight: bold; }

        /* ========================================== */
        /* MODO NOTURNO AGRESSIVO (Domando o Bootstrap)*/
        /* ========================================== */
        body.dark-mode { background-color: #212529 !important; color: #f8f9fa !important; }
        body.dark-mode .navbar { background-color: #2c3034 !important; border-bottom: 3px solid var(--ifood-red) !important; }
       
        body.dark-mode .bg-white,
        body.dark-mode .bg-light,
        body.dark-mode .bg-scar-light { background-color: #2c3034 !important; color: #f8f9fa !important; }
       
        body.dark-mode .text-dark { color: #f8f9fa !important; }
        body.dark-mode .text-muted { color: #ced4da !important; }
       
        body.dark-mode .card,
        body.dark-mode .modal-content,
        body.dark-mode .list-group-item { background-color: #2c3034 !important; color: #f8f9fa !important; border-color: #495057 !important; }
       
        body.dark-mode .border,
        body.dark-mode .border-top,
        body.dark-mode .border-bottom,
        body.dark-mode .border-start,
        body.dark-mode .border-end { border-color: #495057 !important; }
       
        body.dark-mode .form-control,
        body.dark-mode .form-select,
        body.dark-mode input,
        body.dark-mode textarea { background-color: #343a40 !important; color: #fff !important; border-color: #495057 !important; }
       
        body.dark-mode .shadow-sm { box-shadow: 0 .125rem .25rem rgba(0,0,0,.5) !important; }

        body.dark-mode .table { --bs-table-bg: transparent; color: #f8f9fa !important; border-color: #495057 !important; }
        body.dark-mode .table td,
        body.dark-mode .table th,
        body.dark-mode .table thead th { background-color: #2c3034 !important; color: #f8f9fa !important; border-color: #495057 !important; }
        body.dark-mode .table-hover tbody tr:hover td,
        body.dark-mode .table-hover tbody tr:hover th { background-color: #343a40 !important; color: #fff !important; }

        body.dark-mode .btn-light,
        body.dark-mode .btn-white { background-color: #343a40 !important; color: #f8f9fa !important; border-color: #495057 !important; }
        body.dark-mode .btn-light:hover,
        body.dark-mode .btn-white:hover { background-color: #495057 !important; color: #fff !important; }
    </style>
</head>
<body>
    <script>
        if (localStorage.getItem('theme') === 'dark') {
            document.body.classList.add('dark-mode');
        }
    </script>

    <div class="hours-strip text-center" aria-label="Horário de funcionamento">
        <i class="far fa-clock" aria-hidden="true"></i> SEG A SEX: 18:00 - 23:30 | SÁB E DOM: 18:00 - 00:30
    </div>

    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm mb-3" id="mainNav">
            <div class="container">
                <a class="navbar-brand fw-bold text-ifood-red" href="/" style="font-size: 1.6rem;" aria-label="Página Inicial ScarFood">
                    Scar<span class="text-dark">Food</span>
                </a>

                @{
                    // PIM: Aqui capturamos o usuário logado e a página atual para esconder o carrinho!
                    var userEmail = HttpContextAccessor.HttpContext?.Session.GetString("UserEmail");
                    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
                    
                    bool esconderCarrinho = (currentController == "Home" && currentAction == "Pedidos") || 
                                            (currentController == "Autenticacao" && currentAction == "Perfil");
                }

                <div class="d-flex align-items-center gap-1 order-lg-last">
                    <button class="btn p-1 border-0 bg-transparent" onclick="toggleDarkMode()" aria-label="Modo Noturno">
                        <i id="iconNoturno" class="fas fa-moon text-danger" style="font-size: 1.1rem;" aria-hidden="true"></i>
                    </button>

                    @if (userEmail != null && !esconderCarrinho)
                    {
                        <button class="btn p-1 border-0 bg-transparent" onclick="abrirCarrinhoLateral()" aria-label="Carrinho">
                            <i class="fas fa-shopping-cart text-danger" style="font-size: 1.1rem;" aria-hidden="true"></i>
                        </button>
                    }

                    <button class="navbar-toggler border-0 p-1" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                        <span class="navbar-toggler-icon" style="width: 1.2em; height: 1.2em;"></span>
                    </button>
                </div>

                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-end align-items-center">
                    <ul class="navbar-nav gap-3 align-items-lg-center mt-3 mt-lg-0">
                        @if (userEmail != null)
                        {
                            if (userEmail == "admin@scarfood.com")
                            {
                                <li class="nav-item"><a class="btn bg-ifood-red text-white btn-sm px-3 fw-bold w-100 mb-2 mb-lg-0" href="/Admin/Painel">ADMIN</a></li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark fw-bold" asp-controller="Home" asp-action="Pedidos">Pedidos</a>
                                </li>
                            }

                            <li class="nav-item">
                                <a class="nav-link text-dark fw-bold" asp-controller="Autenticacao" asp-action="Perfil">Perfil</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link text-ifood-red fw-bold text-center" asp-controller="Autenticacao" asp-action="Login">Login</a></li>
                            <li class="nav-item"><a class="btn bg-ifood-red text-white btn-sm px-4 fw-bold rounded-pill w-100" asp-controller="Autenticacao" asp-action="Registro">Cadastrar</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            if (document.body.classList.contains('dark-mode')) {
                document.getElementById('iconNoturno').classList.replace('fa-moon', 'fa-sun');
            }
        });

        function toggleDarkMode() {
            const body = document.body;
            const icon = document.getElementById('iconNoturno');
            body.classList.toggle('dark-mode');
           
            if (body.classList.contains('dark-mode')) {
                icon.classList.replace('fa-moon', 'fa-sun');
                localStorage.setItem('theme', 'dark');
            } else {
                icon.classList.replace('fa-sun', 'fa-moon');
                localStorage.setItem('theme', 'light');
            }
        }

        function abrirCarrinhoLateral() {
            const sidebar = document.getElementById('carrinhoLateral');
            const overlay = document.getElementById('overlayCarrinho');

            if (sidebar && overlay) {
                sidebar.classList.add('active');
                overlay.style.display = "block";
       
                if (typeof window.atualizarItensLateral === "function") {
                    window.atualizarItensLateral();
                }
            } else {
                window.location.href = '/Carrinho/Index';
            }
        }

        function buscarCEP() {
            let cep = document.getElementById('cep').value.replace(/\D/g, '');
            if (cep.length !== 8) return;

            fetch(`https://viacep.com.br/ws/${cep}/json/`)
                .then(res => res.json())
                .then(data => {
                    if (!data.erro) {
                        document.getElementById('inputEndereco').value = data.logradouro;
                        document.getElementById('inputBairro').value = data.bairro;
                        document.getElementById('inputNumero').focus();
                    } else {
                        alert("CEP não localizado.");
                    }
                })
                .catch(() => console.error("Erro ao consultar ViaCEP"));
        }

        function salvarEnderecoNovo() {
            let dados = {
                cep: document.getElementById('cep').value,
                logradouro: document.getElementById('inputEndereco').value,
                numero: document.getElementById('inputNumero').value,
                bairro: document.getElementById('inputBairro').value,
                complemento: document.getElementById('inputComplemento').value
            };

            $.post("/Carrinho/SalvarEnderecoNovo", dados, function(res) {
                if(res.success) {
                    console.log("Endereço salvo com sucesso em Araçatuba!");
                }
            });
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)

    <div vw class="enabled">
        <div vw-access-button class="active"></div>
        <div vw-plugin-wrapper>
            <div class="vw-plugin-top-wrapper"></div>
        </div>
    </div>
    <script src="https://vlibras.gov.br/app/vlibras-plugin.js"></script>
    <script>
        new window.VLibras.Widget('https://vlibras.gov.br/app');
    </script>
</body>
</html>